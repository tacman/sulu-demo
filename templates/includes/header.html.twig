{% set type = type|default('default') %}
{% set class = '' %}
{% set title = content.title|default %}
{% set subtitle = content.subtitle|default %}
{% set image = content.headerImage|default %}
{% set url = '' %}

{% if type == 'homepage' %}
    {% set class = ' header--large' %}

    {% if content.teaser|default %}
        {% set teaser = sulu_page_load(content.teaser, ['title', 'subtitle', 'headerImage', 'url']) %}
        {% set title = teaser.content.title|default(title) %}
        {% set subtitle = teaser.content.subtitle|default(subtitle) %}
        {% set image = teaser.content.headerImage|default(image) %}
        {% set url = teaser.content.url|default ? sulu_content_path(teaser.content.url) : '' %}
    {% endif %}
{% endif %}

{% set isArticle = (type == 'article') %}

<div class="header{{ class }}{{ isArticle ? ' header--article' }}">
    {% if image %}
        <img src="{{ sulu_get_media_url(image) }}" alt="{{ title|default('Sulu Rocks') }}" class="header__image">
    {% else %}
        <img src="{{ asset('website/images/default-header-image.jpg') }}" alt="Sulu Rocks" class="header__image">
    {% endif %}

    <div class="header__text">
        <h1 class="header__title{{ isArticle ? ' header__title--small' }}">{{ title }}</h1>

        {% if subtitle %}
            <span class="header__subtitle">{{ subtitle }}</span>
        {% endif %}

        {% if url %}
            <a href="{{ url }}" class="button header__button">{{ 'read_more'|trans }}</a>
        {% endif %}
    </div>
</div>
