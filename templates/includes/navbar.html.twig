<nav class="navbar" data-controller="navigation">
    <a href="{{ sulu_content_root_path() }}" class="navbar__logo">
        <img src="{{ asset('website/images/logo.svg') }}" alt="Sulu.rocks" class="navbar__logo-image">
    </a>

    <div class="navbar__navigation">
        <div class="navbar__links" id="navigation" data-navigation-target="links">
            {% for item in sulu_page_navigation_root_flat('main', 1) %}
                {% set itemUrl = sulu_content_path(item.url) %}
                <a href="{{ itemUrl }}"
                   title="{{ item.title }}"
                   {% if item.nodeType|default == 4 %}target="_blank" rel="noopener"{% endif %}
                   class="navbar__item{{ sulu_page_navigation_is_active(app.request.pathInfo, itemUrl) ? ' navbar__item--active' : '' }}">
                    {{ item.excerpt.title|default(item.title) }}
                </a>
            {% endfor %}
        </div>

        <div class="navbar__locales">
            {% for localization in localizations %}
                <a href="{{ localization.url }}"
                   title="{{ localization.locale }}"
                   class="navbar__item navbar__item--locale{{ localization.locale == app.request.locale ? ' navbar__item--active' : '' }}">
                    {{ localization.locale|upper }}
                </a>
            {% endfor %}
        </div>

        <button type="button"
                class="navbar__toggler icon icon--menu"
                data-navigation-target="toggle"
                data-action="navigation#toggle"
                aria-controls="navigation"
                aria-label="{{ 'navigation'|trans }}"></button>
    </div>
</nav>
