<div class="albums" data-controller="tabs" data-tabs-hash-value="true">
    <h2 class="albums__title">{{ 'albums'|trans }}</h2>

    <div class="albums__wrapper">
        <div class="albums__links">
            {% for album in content.albums %}
                <button type="button"
                        class="albums__link"
                        data-tabs-target="tab"
                        data-action="tabs#choose"
                        data-name="{{ album.title }}">
                    {% set image = sulu_resolve_media(album.image, app.request.locale) %}
                    {% if image %}
                        <img src="{{ sulu_get_media_url(image) }}" alt="{{ album.title }}">
                    {% endif %}
                </button>
            {% endfor %}
        </div>

        <div class="albums__containers">
            {% for album in content.albums %}
                <div class="albums__container" data-tabs-target="panel">
                    <h3 class="albums__album-title">{{ album.title }}</h3>
                    <ul class="albums__track-list">
                        {% for track in album.tracklist %}
                            <li>
                                <span class="albums__track-list-index">{{ loop.index ~ '. ' }}</span>
                                {{ track.title }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
